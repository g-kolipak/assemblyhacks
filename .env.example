# Required for voice and text: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=
# Optional for authenticated MCP; required for the standalone API example.
# https://platform.parallel.ai
PARALLEL_API_KEY=

# Optional overrides
# FACTCHECK_SPEAK=all          # fact checker: all | false | off
# PARALLEL_DECISIONS_MODE=fast
# FACTCHECK_PORT=8765          # stream_server.py for the Chrome extension
# BLINK_STEP_WORDS=2            # run live claim detection every N new words
# BLINK_STT_MODEL=universal-streaming-english
# AGENT_GREETING=Which library are you working with?
# LLM_MODEL=your-enabled-tool-calling-model

# Local LiveKit room defaults (console users can ignore these).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
